# ShareFS - Sample Configuration
#
# ShareFS looks for its configuration in this order, and uses the first one it
# finds, whether it was started from the window, the command line or a service:
#
#   Linux    /etc/sharefs.conf, then ~/.config/sharefs/sharefs.conf
#   macOS    /opt/homebrew/etc, /usr/local/etc or /etc/sharefs.conf, then
#            ~/Library/Application Support/ShareFS/sharefs.conf
#   Both     ./sharefs.conf, so an unpacked archive works where it stands
#
# `sharefs config search` prints the list with the one in use marked, and
# `sharefs config path` prints just that one.

[server]
# Logging: none, error, info, debug, protocol
log_level = info
# Where to write the log. Defaults to /var/log/sharefs/sharefs.log,
# falling back to a per-user location when that is not writable.
# log_file = /var/log/sharefs/sharefs.log


# Bind to specific IP address (default: all interfaces)
# bind_ip = 192.168.0.2

# Broadcast interval in seconds (default: 3)
broadcast_interval = 3

# Enable Access+ authentication (port 32771)
access_plus = true

# Default public share 
# Files placed here will be visible to all RISC OS clients
[share:Public]
path = /srv/sharefs/Public

# Additional share examples - uncomment and customize

#[share:Documents]
#path = /home/user/documents
#attributes = protected
#password = secret

#[share:Software]
#path = /srv/riscos-apps
#attributes = readonly, hidden

# Example printer - uncomment and customize

#[printer:LaserJet]
#path = /var/spool/riscos/laserjet
#definition = /usr/share/riscos/printers/PostScript,fc6
#description = PostScript Printer
#poll_interval = 5
#command = lpr -P laserjet %f

# MIME type mappings - map file extensions to RISC OS filetypes
[mimemap]
# Text and documents
txt = FFF
text = FFF
pdf = ADF
html = FAF
htm = FAF
css = F79
xml = F80

# Images
jpg = C85
jpeg = C85
png = B60
gif = 695
bmp = 69C
tiff = FF0
tif = FF0
svg = AAD

# Audio/Video
wav = FB1
mp3 = 1AD
ogg = 1AD
mp4 = BF8
avi = FB2

# Archives
zip = A91
gz = F89
tar = C46

# Programming
c = FFF
h = FFF
cpp = FFF
py = FFF
js = FFF
json = FFF
bas = FFB

# Data
csv = DFE
dat = FFD
