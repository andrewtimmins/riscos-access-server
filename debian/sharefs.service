[Unit]
Description=ShareFS Server
Documentation=https://github.com/andrewtimmins/riscos-access-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sharefs-server
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/sharefs

[Install]
WantedBy=multi-user.target
