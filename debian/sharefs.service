[Unit]
Description=ShareFS file sharing for RISC OS clients
Documentation=https://github.com/andrewtimmins/sharefs-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sharefs serve
Restart=on-failure
RestartSec=5

# Security hardening.
#
# ProtectSystem=full keeps /usr, /boot and /etc read-only while leaving the
# places a file server actually serves from writable. It was previously
# "strict", which makes the entire hierarchy read-only bar ReadWritePaths, so
# the server could not write to any share at all - including the
# /srv/sharefs/Public that its own postinst creates.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# The log directory, and the default share root created at install time.
#
# If you share directories elsewhere, add them here, for example:
#   sudo systemctl edit sharefs
#   [Service]
#   ReadWritePaths=/mnt/archive
ReadWritePaths=/var/log/sharefs /srv/sharefs

# Home directories are not exposed by default. If you share from /home, drop
# this with a unit override:
#   sudo systemctl edit sharefs
#   [Service]
#   ProtectHome=false
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
